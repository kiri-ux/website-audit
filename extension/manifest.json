{
  "manifest_version": 3,
  "name": "Vici Audit Capture",
  "version": "1.0.0",
  "description": "Captures SEO/GEO audit data from sites that block server-side crawlers, using the real browser render.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Vici Audit Capture" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
